# ============================================
# SERVNIX CONFIGURATION
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ============================================
# GITHUB CONFIGURATION
# ============================================
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=nick-rift
GITHUB_REPO=Servnix
GITHUB_BRANCH=main

# ============================================
# NOTIFICATION & ALERTS
# ============================================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXXXXXXX/YYYYYYYYY/ZZZZZZZZZZ
ALERT_EMAIL=admin@example.com
ALERT_EMAIL_SMTP_SERVER=smtp.gmail.com
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_FROM=noreply@servnix.local

# ============================================
# SECURITY SCANNING - ENABLE/DISABLE
# ============================================
ENABLE_FIREWALL_SCAN=true
ENABLE_SSL_AUDIT=true
ENABLE_OWASP_SCAN=true
ENABLE_KERNEL_SCAN=true
ENABLE_DOCKER_SCAN=true
ENABLE_COMPLIANCE_CHECK=true
ENABLE_SAST_ANALYSIS=true
ENABLE_SCA_SCANNING=true

# ============================================
# DEPENDENCY UPDATE CONFIGURATION
# ============================================
AUTO_MERGE_PATCH=true
AUTO_MERGE_MINOR=true
AUTO_MERGE_MAJOR=false
AUTO_UPDATE_FREQUENCY=daily
TEST_BEFORE_MERGE=true

# ============================================
# FIREWALL & NETWORK
# ============================================
FIREWALL_TOOL=ufw
ALLOWED_PORTS=22,80,443
FAIL2BAN_ENABLED=true
FAIL2BAN_MAX_RETRIES=5

# ============================================
# SSL/TLS CONFIGURATION
# ============================================
SSL_MIN_TLS_VERSION=1.2
SSL_CIPHER_STRENGTH=strong
SSL_CHECK_EXPIRY_DAYS=30

# ============================================
# SCANNING TIMEOUTS & THRESHOLDS
# ============================================
SCAN_TIMEOUT_SECONDS=300
VULN_CRITICAL_THRESHOLD=0
VULN_HIGH_THRESHOLD=5
VULN_MEDIUM_THRESHOLD=20

# ============================================
# LOGGING & REPORTING
# ============================================
LOG_LEVEL=info
LOG_FORMAT=json
RETENTION_DAYS=90
DASHBOARD_PORT=3000
DASHBOARD_HOST=localhost

# ============================================
# COMPLIANCE STANDARDS
# ============================================
COMPLIANCE_STANDARDS=CIS,GDPR,HIPAA,PCI-DSS
COMPLIANCE_REPORT_FREQUENCY=weekly

# ============================================
# ADVANCED OPTIONS
# ============================================
DEBUG_MODE=false
DRY_RUN=false
MAX_PARALLEL_SCANS=4
