# Servnix Konfiguration
# Kopieren nach .env und Werte anpassen. .env NIEMALS committen.

# --- Server / Dashboard ---
PORT=3000
# Nur lokal erreichbar lassen (Sicherheitsvorgabe). Zugriff von deinem PC aus
# per SSH-Tunnel: ssh -L 3000:localhost:3000 <user>@<server-ip>
# NUR aendern (z.B. auf 0.0.0.0), wenn ein eigener Reverse-Proxy mit TLS +
# Auth davorsteht - sonst haengt das Dashboard offen im Netz.
HOST=127.0.0.1
DASHBOARD_USER=admin
# Bcrypt-Hash des Dashboard-Passworts. Erzeugen mit:
#   node server/cli-hash-password.js "DeinPasswort"
DASHBOARD_PASSWORD_HASH=
SESSION_SECRET=change-me-to-a-long-random-string

# --- OPNsense-Anbindung (optional) ---
# API-Key/Secret erzeugst du in OPNsense unter System > Access > Users > API Keys.
OPNSENSE_HOST=
OPNSENSE_API_KEY=
OPNSENSE_API_SECRET=
# Nur auf true setzen, wenn OPNsense ein gültiges, vertrauenswürdiges TLS-Zertifikat hat.
OPNSENSE_VERIFY_TLS=true

# --- Scan-Verhalten ---
SCAN_TARGET_HOST=localhost
SCAN_TARGET_URL=https://localhost
ENABLE_FIREWALL_SCAN=true
ENABLE_SSL_AUDIT=true
ENABLE_HTTP_HEADER_AUDIT=true
ENABLE_DEPENDENCY_AUDIT=true
ENABLE_KERNEL_AUDIT=true
ENABLE_FAIL2BAN_AUDIT=true

# --- Alerts (optional) ---
SLACK_WEBHOOK_URL=
ALERT_EMAIL=

# --- Servnix Guard (automatische Angriffserkennung) ---
# Regelbasierte Erkennung, KEINE KI: zaehlt echte Ereignisse aus echten Logs
# (journalctl/auth.log fuer SSH, nftables-Kernel-Log fuer Portscans) und
# sperrt bei Ueberschreiten der Schwelle die Quell-IP am gesamten Server
# (nftables-Set "blackhole_v4"), nicht nur im Dashboard.
#
# WICHTIG: Trage deine eigene IP (z.B. deine Heim-/Buero-IP oder die IP,
# von der du per SSH zugreifst) hier ein, sonst kannst du dich bei zu vielen
# Fehlversuchen selbst aussperren!
GUARD_ALLOWLIST=

# Wie oft der Guard-Daemon prueft (Sekunden), im Dauerbetrieb via systemd:
GUARD_POLL_INTERVAL_SECONDS=60

# SSH-Bruteforce-Schwelle: ab X fehlgeschlagenen Logins innerhalb von Y Minuten
# wird die Quell-IP gesperrt.
GUARD_SSH_MAX_FAILURES=8
GUARD_SSH_WINDOW_MINUTES=10

# Portscan-Schwelle: ab X verschiedenen angefragten (nicht erlaubten) Ports
# innerhalb von Y Minuten wird die Quell-IP gesperrt. Setzt voraus, dass
# scripts/servnix-firewall.sh installiert ist (schreibt das Scan-Log).
GUARD_PORTSCAN_MAX_PORTS=15
GUARD_PORTSCAN_WINDOW_MINUTES=5

# USB-Geraete-Ueberwachung: erkennt neu angeschlossene USB-Geraete (lsusb-Diff)
# und meldet sie als Security-Event. Das ist Erkennung/Alarm, KEIN
# automatisches Sperren von USB-Ports (dafuer braucht es z.B. usbguard).
GUARD_ENABLE_USB_MONITOR=true

