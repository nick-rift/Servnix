    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "winston": "^3.10.0",
    "joi": "^17.10.2",
    "octokit": "^2.0.14",
    "node-cron": "^3.0.2",
    "chalk": "^5.3.0",
    "yaml": "^2.3.3"
  },
  "devDependencies": {
    "@types/node": "^20.5.0",
    "eslint": "^8.48.0",
